@echo off
title Verificador de Seriais
echo ============================================================
echo   SERIAIS ATUAIS DO SISTEMA
echo ============================================================
echo.

echo [MachineGuid]
powershell -NoProfile -Command "(Get-ItemProperty -Path 'HKLM:\SOFTWARE\Microsoft\Cryptography' -Name MachineGuid -ErrorAction SilentlyContinue).MachineGuid"
echo.

echo [MAC Address (primeiro adaptador fisico ativo)]
powershell -NoProfile -Command "$a = Get-NetAdapter -Physical -ErrorAction SilentlyContinue | Where-Object { $_.Status -eq 'Up' } | Select-Object -First 1; if (-not $a) { $a = Get-NetAdapter -Physical | Select-Object -First 1 }; if ($a) { $a.MacAddress } else { 'N/A' }"
echo.

echo [Volume Serial Number (C:)]
vol C:
echo.

echo [BIOS Serial]
powershell -NoProfile -Command "(Get-CimInstance Win32_BIOS -ErrorAction SilentlyContinue).SerialNumber"
echo.

echo [System UUID]
powershell -NoProfile -Command "(Get-CimInstance Win32_ComputerSystemProduct -ErrorAction SilentlyContinue).UUID"
echo.

echo [Baseboard Serial]
powershell -NoProfile -Command "(Get-CimInstance Win32_BaseBoard -ErrorAction SilentlyContinue).SerialNumber"
echo.

echo ============================================================
pause
